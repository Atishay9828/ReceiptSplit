# Application environment
RECEIPTSPLIT_ENV=development

# PostgreSQL - asyncpg driver
# Format: postgresql+asyncpg://user:password@host:port/dbname
RECEIPTSPLIT_DATABASE_URL=postgresql+asyncpg://receiptsplit:receiptsplit@127.0.0.1:54329/receiptsplit_dev

# Supabase - for Realtime event broadcasting
RECEIPTSPLIT_SUPABASE_URL=https://your-project.supabase.co
RECEIPTSPLIT_SUPABASE_SERVICE_KEY=your-service-role-key-here

# CORS - comma-separated list of allowed frontend origins
RECEIPTSPLIT_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Security
# Token entropy is fixed at 32 bytes (256 bits) - do not reduce.
# No override needed unless running tests with a fixed seed.
RECEIPTSPLIT_AUTH_OIDC_PROVIDER=dev

# OCR local development
RECEIPTSPLIT_OCR_PROVIDER=mock
RECEIPTSPLIT_OCR_STORAGE_BACKEND=local
RECEIPTSPLIT_OCR_LOCAL_STORAGE_DIR=.local/ocr
RECEIPTSPLIT_OCR_STORE_RAW_TEXT=false

# Logging
RECEIPTSPLIT_LOG_LEVEL=INFO
